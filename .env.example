# Required in every environment. Use a unique random value of at least 32 bytes.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
DATABASE_PATH=autotrader.db
# Set true only behind HTTPS
COOKIE_SECURE=false
# Comma-separated KST dates
KR_HOLIDAYS=2026-01-01
# Required only by the non-browser internal decision-card API / CLI. Never commit its value.
INTERNAL_API_KEY=replace-with-a-unique-random-secret
# Optional KIS read-only current-price integration. Names only; never commit values.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=
# Account values are presence-only readiness signals in this release; no account endpoint is called.
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=
# Legacy presence-only alias accepted only for a verified 8-digit account number.
R_ACCOUNT_NUMBER=
# Required central strategy thresholds for the 08:00 pre-market filter. Values are KRW or percent;
# deployment must supply reviewed values (there are intentionally no runtime defaults).
GIRAFFE_MIN_TRADING_VALUE_KRW=
GIRAFFE_MIN_MARKET_CAP_KRW=
GIRAFFE_MAX_MARKET_CAP_KRW=
GIRAFFE_MAX_RECENT_RISE_PCT=
GIRAFFE_MAX_GAP_PCT=
# v1 is frozen. Set this explicit v2 identity to enable the completed-session priced-in gate.
GIRAFFE_FILTER_CONFIG_VERSION=giraffe-premarket-filter-v2-short-term-priced-in
GIRAFFE_SHORT_TERM_RISE_SESSIONS=2
GIRAFFE_MAX_SHORT_TERM_EXCESS_RISE_PCT=
GIRAFFE_MAX_PRE_RETURN_PCT=
