# Generate a unique value on the deployment host:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_SECONDS=28800
SIGNUP_ENABLED=false
# Comma-separated KST dates; update as the exchange calendar changes.
KR_HOLIDAYS=
# Internal decision-card writer/CLI key; keep only in deployment env.
INTERNAL_API_KEY=replace-with-a-unique-random-secret
IMAGE_TAG=latest
